---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPeople, getTrips } from '../../lib/airtable';

const { id } = Astro.params;
const people = await getPeople();
const person = people.find((p: any) => p.airtableId === id);

if (!person) return Astro.redirect('/');

const allTrips = await getTrips('approved');
const personTrips = allTrips
  .filter(t => t.person_name === person.name)
  .sort((a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayStr = today.toISOString().split('T')[0];

function tripStatus(trip: typeof personTrips[0]) {
  if (trip.start_date <= todayStr && trip.end_date >= todayStr) return 'now';
  if (trip.start_date > todayStr) return 'next';
  return 'past';
}

function formatRange(start: string, end: string) {
  const s = new Date(start + 'T12:00:00');
  const e = new Date(end   + 'T12:00:00');
  const mo = (d: Date) => d.toLocaleString('en-US', { month: 'short' });
  if (s.getMonth() === e.getMonth()) return `${mo(s)} ${s.getDate()}–${e.getDate()}`;
  return `${mo(s)} ${s.getDate()} – ${mo(e)} ${e.getDate()}`;
}

// Group trips by month
const byMonth = new Map<string, typeof personTrips>();
for (const trip of personTrips) {
  const month = new Date(trip.start_date + 'T12:00:00').toLocaleString('en-US', { month: 'long', year: 'numeric' });
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(trip);
}

// Hero status line
const currentTrip = personTrips.find(t => tripStatus(t) === 'now');
const nextTrip    = personTrips.find(t => tripStatus(t) === 'next');
---

<BaseLayout title={`${person.name} — Constelaciones`}>
  <style>
    /* ── Hero ─────────────────────────────────────── */
    .hero {
      padding: 2.5rem 0 2rem;
      background: linear-gradient(175deg, var(--sand) 0%, var(--cream) 80%);
      border-bottom: 1px solid var(--clay-lt);
    }

    .back {
      font-size: 0.78rem;
      color: var(--fog);
      text-decoration: none;
      letter-spacing: 0.02em;
      display: inline-block;
      margin-bottom: 0.75rem;
      transition: color 0.15s;
    }
    .back:hover { color: var(--clay); }

    .hero h1 { margin-bottom: 0.35rem; }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      font-size: 0.875rem;
      color: var(--fog);
      margin-top: 0.25rem;
    }
    .hero-meta .sep { color: var(--clay-lt); }

    .status-now {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: #2d7c45;
      font-weight: 500;
    }
    .status-now::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #2d7c45;
      display: inline-block;
    }

    /* ── Trip list ────────────────────────────────── */
    .content { padding: 2.5rem 0 5rem; }

    .month-group { margin-bottom: 2.5rem; }

    .month-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--fog);
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--clay-lt);
      margin-bottom: 0.15rem;
    }

    .trip-row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.55rem 0.5rem;
      border-bottom: 1px solid rgba(232, 195, 176, 0.3);
      border-radius: 3px;
      margin: 0 -0.5rem;
      transition: background 0.12s;
      text-decoration: none;
    }
    .trip-row:hover { background: var(--sand); }
    .trip-row.past { opacity: 0.45; }

    .trip-dot {
      flex: 0 0 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
    }
    .dot-now {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #2d7c45;
    }

    .trip-dates {
      flex: 0 0 110px;
      font-size: 0.82rem;
      color: var(--fog);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .trip-dest {
      flex: 1;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--bark);
    }

    .trip-tag {
      flex: 0 0 auto;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fog);
      white-space: nowrap;
    }

    .trip-notes {
      font-size: 0.78rem;
      color: var(--fog);
      font-style: italic;
      margin-left: 0.5rem;
      font-weight: 400;
    }

    .empty { padding: 2rem 0; color: var(--fog); font-style: italic; }

    @media (max-width: 600px) {
      .trip-dates { flex: 0 0 80px; font-size: 0.75rem; }
      .trip-tag   { display: none; }
    }
  </style>

  <section class="hero">
    <div class="wrap">
      <a class="back" href="/">← Home</a>
      <h1>{person.name}</h1>
      <div class="hero-meta">
        {person.home_city && <span>{person.home_city}</span>}
        {person.home_city && <span class="sep">·</span>}
        <span>{personTrips.length} {personTrips.length === 1 ? 'trip' : 'trips'}</span>
        {currentTrip && (
          <>
            <span class="sep">·</span>
            <span class="status-now">Currently in {currentTrip.destination}</span>
          </>
        )}
        {!currentTrip && nextTrip && (
          <>
            <span class="sep">·</span>
            <span>Next: {nextTrip.destination} ({formatRange(nextTrip.start_date, nextTrip.end_date)})</span>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="content">
    <div class="wrap">
      {byMonth.size === 0 ? (
        <p class="empty">No trips added yet.</p>
      ) : [...byMonth.entries()].map(([month, trips]) => (
        <div class="month-group">
          <div class="month-label">{month}</div>
          {trips.map(trip => {
            const status = tripStatus(trip);
            return (
              <a href={`/trips/${trip.airtableId}`} class={`trip-row ${status === 'past' ? 'past' : ''}`}>
                <span class="trip-dot">
                  {status === 'now' && <span class="dot-now"></span>}
                </span>
                <span class="trip-dates">{formatRange(trip.start_date, trip.end_date)}</span>
                <span class="trip-dest">
                  {trip.destination}
                  {trip.notes && <span class="trip-notes">{trip.notes}</span>}
                </span>
                {trip.event_tag && <span class="trip-tag">{trip.event_tag}</span>}
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
