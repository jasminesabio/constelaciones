---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPeople, getTrips } from '../../lib/airtable';

const people = await getPeople();
const trips = await getTrips('approved');

const peopleWithTrips = people.map((p) => ({
  ...p,
  tripCount: trips.filter((t) => t.person_name === p.name).length,
}));

const sorted = peopleWithTrips.sort((a, b) => b.tripCount - a.tripCount);
---

<BaseLayout title="Constelaciones — Friends">
  <style>
    .page-header {
      padding-block: 3rem;
      background: var(--sand);
    }

    .page-header h1 {
      margin-bottom: 0.5rem;
    }

    .friends-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .friend-card {
      background: white;
      border: 1px solid var(--clay-lt);
      padding: 1.5rem;
      border-radius: 4px;
      text-align: center;
      text-decoration: none;
      transition: border-color 0.2s;
    }

    .friend-card:hover {
      border-color: var(--clay);
    }

    .friend-avatar {
      width: 80px;
      height: 80px;
      margin: 0 auto 1rem;
      border-radius: 50%;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }

    .friend-name {
      font-family: var(--serif);
      font-size: 1.1rem;
      color: var(--bark);
      margin-bottom: 0.25rem;
    }

    .friend-city {
      font-size: 0.9rem;
      color: var(--fog);
      margin-bottom: 1rem;
    }

    .friend-trips {
      font-size: 0.85rem;
      color: var(--ink);
    }

    .trip-count {
      font-family: var(--serif);
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--clay);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--fog);
    }
  </style>

  <section class="section page-header">
    <div class="wrap">
      <h1>Friends in Constelaciones</h1>
      <p>Roster of {people.length} contributors</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {sorted.length > 0 ? (
        <div class="friends-grid">
          {sorted.map((person: any) => (
            <a href={`/friends/${person.airtableId}`} class="friend-card">
              <div class="friend-avatar">
                {person.avatar_url ? (
                  <img src={person.avatar_url} alt={person.name} style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                ) : (
                  person.name.charAt(0).toUpperCase()
                )}
              </div>
              <h3 class="friend-name">{person.name}</h3>
              {person.home_city && <div class="friend-city">{person.home_city}</div>}
              <div class="friend-trips">
                <div class="trip-count">{person.tripCount}</div>
                <div>{person.tripCount === 1 ? 'trip' : 'trips'}</div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No friends listed yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
