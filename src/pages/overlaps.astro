---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrips, getPeople } from '../lib/airtable';

const trips = await getTrips('approved');
const people = await getPeople();

// Calculate overlaps
type Overlap = {
  destination: string;
  people: string[];
  startDate: string;
  endDate: string;
};

const overlaps: Overlap[] = [];

for (let i = 0; i < trips.length; i++) {
  for (let j = i + 1; j < trips.length; j++) {
    const trip1 = trips[i];
    const trip2 = trips[j];

    // Check if same destination
    if (trip1.destination === trip2.destination) {
      const start1 = new Date(trip1.start_date);
      const end1 = new Date(trip1.end_date);
      const start2 = new Date(trip2.start_date);
      const end2 = new Date(trip2.end_date);

      // Check if dates overlap
      if (start1 <= end2 && start2 <= end1) {
        const person1 = trip1.person_name || 'Unknown';
        const person2 = trip2.person_name || 'Unknown';

        // Don't show overlaps for the same person
        if (person1 === person2) continue;

        const overlapStart = new Date(Math.max(start1.getTime(), start2.getTime()));
        const overlapEnd = new Date(Math.min(end1.getTime(), end2.getTime()));

        overlaps.push({
          destination: trip1.destination,
          people: [person1, person2],
          startDate: overlapStart.toISOString().split('T')[0],
          endDate: overlapEnd.toISOString().split('T')[0],
        });
      }
    }
  }
}

// Sort by date
overlaps.sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime());

// Get unique destinations for filter
const destinations = [...new Set(overlaps.map((o) => o.destination))];
---

<BaseLayout title="Constelaciones — Overlaps">
  <style>
    .page-header {
      padding-block: 3rem;
      background: var(--sand);
    }

    .page-header h1 {
      margin-bottom: 0.5rem;
    }

    .tabs {
      display: flex;
      gap: 1rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--clay-lt);
    }

    .tab-btn {
      background: none;
      border: none;
      padding: 1rem 0;
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--fog);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.2s;
    }

    .tab-btn.active {
      color: var(--bark);
      border-color: var(--clay);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .timeline-item {
      background: white;
      border: 1px solid var(--clay-lt);
      border-left: 3px solid var(--clay);
      padding: 1.5rem;
      border-radius: 4px;
    }

    .timeline-destination {
      font-family: var(--serif);
      font-size: 1.15rem;
      color: var(--bark);
      margin-bottom: 0.5rem;
    }

    .timeline-people {
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 0.75rem;
    }

    .timeline-dates {
      font-size: 0.9rem;
      color: var(--fog);
    }

    .map-placeholder {
      background: var(--sand);
      border: 1px solid var(--clay-lt);
      border-radius: 4px;
      padding: 4rem;
      text-align: center;
      color: var(--fog);
      margin-top: 2rem;
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--fog);
    }

    .filter-group {
      margin-bottom: 1.5rem;
    }

    .filter-group label {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .filter-group select {
      max-width: 300px;
      padding: 0.5rem;
      border: 1px solid var(--clay-lt);
      border-radius: 3px;
    }
  </style>

  <section class="section page-header">
    <div class="wrap">
      <h1>Próximos cruces</h1>
      <p>When and where friends will overlap this summer</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="tabs">
        <button class="tab-btn active" data-tab="timeline">Timeline</button>
        <button class="tab-btn" data-tab="map">Map</button>
      </div>

      <div class="tab-content active" id="timeline" data-tab="timeline">
        {overlaps.length > 0 ? (
          <>
            <div class="filter-group">
              <label for="destination-filter">Filter by destination</label>
              <select id="destination-filter">
                <option value="">All destinations</option>
                {destinations.map((d) => (
                  <option value={d}>{d}</option>
                ))}
              </select>
            </div>

            <div class="timeline">
              {overlaps.map((overlap) => {
                const startDate = new Date(overlap.startDate).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                });
                const endDate = new Date(overlap.endDate).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                });
                return (
                  <div class="timeline-item" data-destination={overlap.destination}>
                    <div class="timeline-destination">{overlap.destination}</div>
                    <div class="timeline-people">
                      {overlap.people.join(' ↔ ')}
                    </div>
                    <div class="timeline-dates">
                      {startDate} — {endDate}
                    </div>
                  </div>
                );
              })}
            </div>
          </>
        ) : (
          <div class="empty-state">
            <p>No overlaps scheduled yet. Add trips to see when friends will cross paths.</p>
          </div>
        )}
      </div>

      <div class="tab-content" id="map" data-tab="map">
        <div class="map-placeholder">
          <p>Interactive map coming soon.</p>
          <p style="font-size: 0.9rem; margin-top: 1rem;">
            In the meantime, check the timeline to see where everyone's converging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabName = btn.getAttribute('data-tab');

        // Hide all
        tabContents.forEach((content) => content.classList.remove('active'));
        tabBtns.forEach((b) => b.classList.remove('active'));

        // Show selected
        document.getElementById(tabName)?.classList.add('active');
        btn.classList.add('active');
      });
    });

    // Filter functionality
    const filterSelect = document.getElementById('destination-filter') as HTMLSelectElement;
    const timelineItems = document.querySelectorAll('.timeline-item');

    filterSelect?.addEventListener('change', () => {
      const selectedDestination = filterSelect.value;

      timelineItems.forEach((item) => {
        const destination = item.getAttribute('data-destination');
        if (selectedDestination === '' || destination === selectedDestination) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  </script>
</BaseLayout>
