---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrips } from '../lib/airtable';

const trips = await getTrips('approved');

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayStr = today.toISOString().split('T')[0];

type OverlapGroup = {
  destination: string;
  people: string[];
  startDate: string;
  endDate: string;
};

// Group trips by destination
const byDest = new Map<string, typeof trips>();
for (const trip of trips) {
  if (!byDest.has(trip.destination)) byDest.set(trip.destination, []);
  byDest.get(trip.destination)!.push(trip);
}

// Sweep-line: for each destination, find all intervals where 2+ people overlap
const rawOverlaps: OverlapGroup[] = [];

for (const [destination, destTrips] of byDest) {
  if (destTrips.length < 2) continue;

  // Collect all boundary dates as interval breakpoints
  const dates = new Set<string>();
  for (const t of destTrips) {
    dates.add(t.start_date);
    dates.add(t.end_date);
  }
  const sorted = [...dates].sort();

  for (let i = 0; i < sorted.length - 1; i++) {
    const iStart = sorted[i];
    const iEnd   = sorted[i + 1];

    // Skip intervals fully in the past
    if (iEnd <= todayStr) continue;

    const present = destTrips
      .filter(t => t.start_date <= iStart && t.end_date >= iEnd)
      .map(t => t.person_name!)
      .filter(Boolean);

    if (present.length >= 2) {
      rawOverlaps.push({ destination, people: present, startDate: iStart, endDate: iEnd });
    }
  }
}

// Merge consecutive intervals with same destination + same people set
rawOverlaps.sort((a, b) =>
  a.destination.localeCompare(b.destination) || a.startDate.localeCompare(b.startDate)
);

const merged: OverlapGroup[] = [];
for (const o of rawOverlaps) {
  const last = merged[merged.length - 1];
  const sameGroup =
    last &&
    last.destination === o.destination &&
    last.endDate === o.startDate &&
    JSON.stringify([...last.people].sort()) === JSON.stringify([...o.people].sort());

  if (sameGroup) {
    last.endDate = o.endDate;
  } else {
    merged.push({ ...o, people: [...o.people] });
  }
}

// Sort chronologically
merged.sort((a, b) => a.startDate.localeCompare(b.startDate));

// Group by month
const byMonth = new Map<string, OverlapGroup[]>();
for (const o of merged) {
  const month = new Date(o.startDate + 'T12:00:00').toLocaleString('en-US', { month: 'long', year: 'numeric' });
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(o);
}

function formatRange(start: string, end: string) {
  const s = new Date(start + 'T12:00:00');
  const e = new Date(end   + 'T12:00:00');
  const mo = (d: Date) => d.toLocaleString('en-US', { month: 'short' });
  if (s.getMonth() === e.getMonth()) return `${mo(s)} ${s.getDate()}–${e.getDate()}`;
  return `${mo(s)} ${s.getDate()} – ${mo(e)} ${e.getDate()}`;
}

const totalCount = merged.length;
---

<BaseLayout title="Constelaciones — Overlaps">
  <style>
    /* ── Hero ─────────────────────────────────────── */
    .hero {
      padding: 2.5rem 0 2rem;
      background: linear-gradient(175deg, var(--sand) 0%, var(--cream) 80%);
      border-bottom: 1px solid var(--clay-lt);
    }
    .hero h1 { margin-bottom: 0.35rem; }
    .hero p  { color: var(--fog); font-size: 1rem; max-width: none; }

    /* ── Content ──────────────────────────────────── */
    .content { padding: 2.5rem 0 5rem; }

    /* ── Month group ──────────────────────────────── */
    .month-group { margin-bottom: 2.5rem; }

    .month-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--fog);
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--clay-lt);
      margin-bottom: 0.15rem;
    }

    /* ── Overlap rows ─────────────────────────────── */
    .overlap-row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.55rem 0.5rem;
      border-bottom: 1px solid rgba(232, 195, 176, 0.3);
      border-radius: 3px;
      margin: 0 -0.5rem;
      transition: background 0.12s;
    }
    .overlap-row:hover { background: var(--sand); }

    .col-dates {
      flex: 0 0 110px;
      font-size: 0.82rem;
      color: var(--fog);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .col-dest {
      flex: 0 0 210px;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--bark);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .col-people {
      flex: 1;
      font-size: 0.875rem;
      color: var(--fog);
      min-width: 0;
    }

    .person-tag {
      display: inline-block;
      background: var(--sand);
      border: 1px solid var(--clay-lt);
      border-radius: 99px;
      padding: 0.1rem 0.55rem;
      font-size: 0.78rem;
      color: var(--bark);
      margin: 0.1rem 0.15rem 0.1rem 0;
      white-space: nowrap;
    }

    .count-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 50%;
      background: var(--clay);
      color: white;
      font-size: 0.65rem;
      font-weight: 700;
      margin-right: 0.4rem;
      flex-shrink: 0;
      vertical-align: middle;
    }

    .empty-state {
      padding: 3rem 0;
      color: var(--fog);
      font-style: italic;
    }

    @media (max-width: 600px) {
      .col-dest { flex: 0 0 140px; }
      .col-dates { flex: 0 0 80px; font-size: 0.75rem; }
    }
  </style>

  <section class="hero">
    <div class="wrap">
      <h1>Próximos cruces</h1>
      <p>{totalCount} overlap{totalCount === 1 ? '' : 's'} from today through the summer</p>
    </div>
  </section>

  <section class="content">
    <div class="wrap">
      {byMonth.size === 0 ? (
        <p class="empty-state">No upcoming overlaps found.</p>
      ) : [...byMonth.entries()].map(([month, overlaps]) => (
        <div class="month-group">
          <div class="month-label">{month}</div>

          {overlaps.map(o => (
            <div class="overlap-row">
              <span class="col-dates">{formatRange(o.startDate, o.endDate)}</span>
              <span class="col-dest" title={o.destination}>{o.destination}</span>
              <span class="col-people">
                {o.people.length >= 3 && (
                  <span class="count-badge">{o.people.length}</span>
                )}
                {o.people.map(name => (
                  <span class="person-tag">{name}</span>
                ))}
              </span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
