---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPeople, getTrips } from '../../lib/airtable';

const { id } = Astro.params;
const people = await getPeople();
const person = people.find((p: any) => p.airtableId === id);
const allTrips = await getTrips('approved');
const personTrips = person ? allTrips.filter((t) => t.person_name === person.name).sort((a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime()) : [];

if (!person) {
  return Astro.redirect('/friends');
}
---

<BaseLayout title={`${person.name} — Constelaciones`}>
  <style>
    .friend-hero {
      padding-block: 3rem;
      background: var(--sand);
    }

    .friend-hero h1 {
      margin-bottom: 1rem;
    }

    .friend-info {
      display: flex;
      gap: 2rem;
      align-items: start;
      margin-top: 1.5rem;
      flex-wrap: wrap;
    }

    .friend-avatar-large {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: var(--clay-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      flex-shrink: 0;
    }

    .friend-meta {
      flex: 1;
    }

    .friend-section {
      padding-block: var(--space-md);
    }

    .trip-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .trip-item {
      border-left: 3px solid var(--clay);
      padding-left: 1.25rem;
    }

    .trip-destination {
      font-weight: 600;
      color: var(--bark);
      margin-bottom: 0.25rem;
    }

    .trip-dates {
      font-size: 0.9rem;
      color: var(--fog);
    }

    .cta-row {
      margin-top: 1.5rem;
      display: flex;
      gap: 1rem;
    }
  </style>

  <section class="section friend-hero">
    <div class="wrap">
      <div class="friend-info">
        <div class="friend-avatar-large">
          {person.avatar_url ? (
            <img src={person.avatar_url} alt={person.name} style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
          ) : (
            person.name.charAt(0).toUpperCase()
          )}
        </div>
        <div class="friend-meta">
          <h1>{person.name}</h1>
          {person.home_city && <div style="font-size: 0.95rem; color: var(--fog); margin-bottom: 1rem;">From {person.home_city}</div>}
          <div style="font-size: 1rem; color: var(--ink);">
            {personTrips.length} {personTrips.length === 1 ? 'trip' : 'trips'} this summer
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section friend-section">
    <div class="wrap">
      {personTrips.length > 0 && (
        <>
          <h2>Trips</h2>
          <div class="trip-list">
            {personTrips.map((trip) => {
              const startDate = new Date(trip.start_date).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
              });
              const endDate = new Date(trip.end_date).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
              });
              return (
                <a href={`/trips/${trip.id}`} class="trip-item" style="text-decoration: none;">
                  <div class="trip-destination">{trip.destination}</div>
                  <div class="trip-dates">{startDate} — {endDate}</div>
                </a>
              );
            })}
          </div>
        </>
      )}

      <div class="cta-row">
        <a href="/friends" class="btn-secondary">← Back to friends</a>
      </div>
    </div>
  </section>
</BaseLayout>
