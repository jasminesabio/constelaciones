---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrips, getTickets, getPeople } from '../lib/airtable';

const trips = await getTrips('approved');
const tickets = await getTickets('available');
const people = await getPeople();

// Get recent updates
const allUpdates = [
  ...trips.slice(0, 3).map((t) => ({
    type: 'trip',
    title: `${t.destination}`,
    date: t.last_updated || 'recently',
    person: t.person_id,
  })),
  ...tickets.slice(0, 3).map((tk) => ({
    type: 'ticket',
    title: `${tk.event_name}`,
    date: tk.last_updated || 'recently',
    person: tk.seller_id,
  })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Count upcoming overlaps (simplified)
const upcomingOverlapCount = trips.filter((t) => {
  const endDate = new Date(t.end_date);
  return endDate > new Date();
}).length;
---

<BaseLayout title="Constelaciones — Dashboard">
  <style>
    .hero {
      padding-block: 4.5rem;
      background: linear-gradient(175deg, var(--sand) 0%, var(--cream) 75%);
    }

    .hero h1 {
      max-width: 20ch;
      margin-bottom: 1rem;
    }

    .hero-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 1.125rem;
      color: var(--moss);
      max-width: 50ch;
      line-height: 1.7;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-top: var(--space-md);
    }

    .dashboard-section h2 {
      font-size: 1.3rem;
      margin-bottom: 1.5rem;
    }

    .update-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .update-item {
      padding-left: 1.375rem;
      position: relative;
    }

    .update-item::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--clay-lt);
      font-family: var(--serif);
    }

    .update-title {
      font-weight: 600;
      color: var(--bark);
      margin-bottom: 0.25rem;
    }

    .update-date {
      font-size: 0.85rem;
      color: var(--fog);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .stat-card {
      background: var(--sand);
      padding: 1.5rem;
      border-radius: 4px;
      border: 1px solid var(--clay-lt);
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 600;
      color: var(--clay);
      font-family: var(--serif);
    }

    .stat-label {
      font-size: 0.85rem;
      color: var(--fog);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 0.5rem;
    }

    .cta-row {
      display: flex;
      gap: 1rem;
      margin-top: var(--space-md);
      flex-wrap: wrap;
    }

    @media (max-width: 700px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding-block: 3rem;
      }
    }
  </style>

  <section class="section hero">
    <div class="wrap">
      <h1>Próximos cruces</h1>
      <p class="hero-sub">Where {people.length}+ friends are wandering this summer. See who's where, when.</p>
      <div class="cta-row">
        <a href="/trips" class="btn-primary">View all trips</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="dashboard-grid">
        <div class="dashboard-section">
          <h2>Recent updates</h2>
          {allUpdates.length > 0 ? (
            <ul class="update-list">
              {allUpdates.map((update) => (
                <li class="update-item">
                  <div class="update-title">
                    {update.type === 'trip' ? '✈️' : '🎫'} {update.title}
                  </div>
                  <div class="update-date">updated {update.date}</div>
                </li>
              ))}
            </ul>
          ) : (
            <p>No updates yet. Be the first to add your summer plans.</p>
          )}
        </div>

        <div class="dashboard-section">
          <h2>At a glance</h2>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-number">{people.length}</div>
              <div class="stat-label">Friends</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">{trips.length}</div>
              <div class="stat-label">Trips planned</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">{tickets.length}</div>
              <div class="stat-label">Tickets available</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">{upcomingOverlapCount}</div>
              <div class="stat-label">Upcoming overlaps</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
