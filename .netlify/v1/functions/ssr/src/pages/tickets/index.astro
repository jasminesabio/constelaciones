---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTickets, getPeople } from '../../lib/airtable';

const tickets = await getTickets('available');
const people = await getPeople();

const sortedTickets = tickets.sort((a, b) => new Date(b.last_updated || '').getTime() - new Date(a.last_updated || '').getTime());
---

<BaseLayout title="Constelaciones — Tickets">
  <style>
    .page-header {
      padding-block: 3rem;
      background: var(--sand);
    }

    .page-header h1 {
      margin-bottom: 0.5rem;
    }

    .tickets-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .ticket-card {
      background: white;
      border: 1px solid var(--clay-lt);
      padding: 1.5rem;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      transition: border-color 0.2s;
    }

    .ticket-card:hover {
      border-color: var(--clay);
    }

    .ticket-event {
      font-family: var(--serif);
      font-size: 1.1rem;
      color: var(--bark);
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .ticket-meta {
      font-size: 0.9rem;
      color: var(--fog);
      margin-bottom: 1rem;
    }

    .ticket-price {
      font-family: var(--serif);
      font-size: 1rem;
      font-weight: 500;
      color: var(--clay);
      margin-bottom: 0.5rem;
    }

    .ticket-seller {
      font-size: 0.85rem;
      color: var(--ink);
      margin-top: auto;
      padding-top: 1rem;
      border-top: 1px solid var(--clay-lt);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--fog);
    }
  </style>

  <section class="section page-header">
    <div class="wrap">
      <h1>Festival & event tickets</h1>
      <p>Selling or seeking summer event passes</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {sortedTickets.length > 0 ? (
        <div class="tickets-grid">
          {sortedTickets.map((ticket: any) => {
            const seller = people.find((p: any) => p.airtableId === ticket.seller_id);
            const eventDate = new Date(ticket.event_date).toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
            });
            return (
              <a href={`/tickets/${ticket.airtableId}`} class="ticket-card">
                <h3 class="ticket-event">{ticket.event_name}</h3>
                <div class="ticket-meta">
                  {ticket.event_location} · {eventDate}
                </div>
                <div class="ticket-price">{ticket.asking_price}</div>
                {ticket.notes && <p style="font-size: 0.9rem; margin: 0.75rem 0;">{ticket.notes}</p>}
                {seller && <div class="ticket-seller">Seller: {seller.name}</div>}
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <p>No tickets available right now. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
